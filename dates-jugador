using System;


public class Persona
{

    public string Nombre { get; set; }
    public string Nif { get; set; }
    public DateTime FechaNac { get; set; }


    public Persona(string nombre, string nif, DateTime fechaNac)
    {
        Nombre = nombre;
        Nif = nif;
        FechaNac = fechaNac;
    }


    public virtual void MostrarInformacion()
    {
        Console.WriteLine($"Nombre: {Nombre}");
        Console.WriteLine($"NIF: {Nif}");
        Console.WriteLine($"Fecha de Nacimiento: {FechaNac.ToShortDateString()}");
    }
}


public class Jugador : Persona
{

    public int NumFed { get; set; }


    public Jugador(string nombre, string nif, DateTime fechaNac, int numFed)
        : base(nombre, nif, fechaNac)
    {
        NumFed = numFed;
    }

  
    public override void MostrarInformacion()
    {
        base.MostrarInformacion();
        Console.WriteLine($"Número de Federado: {NumFed}");
    }
}


class Program
{
    static void Main(string[] args)
    {
   
        Jugador jugador1 = new Jugador(
            "James Salgado",
            "87654321B",
            new DateTime(1996, 5, 13),
            14);

       
        Console.WriteLine("Información del Jugador:");
        jugador1.MostrarInformacion();
    }
}
